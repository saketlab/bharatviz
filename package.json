{
  "name": "bharatviz",
  "private": false,
  "version": "1.0.0",
  "description": "Fast interactive choropleth maps for India - visualize state and district level data with beautiful, customizable maps",
  "keywords": [
    "india",
    "maps",
    "choropleth",
    "visualization",
    "data",
    "geojson",
    "d3",
    "react"
  ],
  "author": "Saket Choudhary <saket@saket.sh>",
  "license": "MIT",
  "homepage": "https://bharatviz.saketlab.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saketlab/bharatviz.git"
  },
  "bugs": {
    "url": "https://github.com/saketlab/bharatviz/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && NODE_OPTIONS=\"--no-deprecation\" firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview --only hosting",
    "sitemap": "node scripts/generate-sitemap.js",
    "generate:sheets": "node scripts/generate-google-sheets.js",
    "update:config-sheets": "node scripts/update-config-with-sheets.js"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.2",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@mapbox/polylabel": "^1.0.2",
    "@mlc-ai/web-llm": "^0.2.79",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@turf/area": "^7.3.4",
    "@turf/bbox": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "d3": "^7.9.0",
    "fast-fuzzy": "^1.12.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "hyparquet": "^1.26.0",
    "hyparquet-compressors": "^1.1.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.462.0",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2",
    "simple-statistics": "^7.8.9",
    "svg2pdf.js": "^2.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.5.5",
    "@types/pako": "^2.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "sitemap": "^9.0.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^7.1.12"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
